{
  "name": "fullstack-dev",
  "version": "1.0.0",
  "description": "Full-stack development agent with database and deploy access",
  "permissions": {
    "files": {
      "read": ["**/*"],
      "write": ["src/**", "tests/**", "docs/**"]
    },
    "shell": true,
    "network": true
  },
  "tools": [
    {"name": "read_file", "description": "Read any project file"},
    {"name": "write_file", "description": "Write to src/tests/docs"},
    {"name": "execute_command", "description": "Run shell commands"},
    {"name": "web_fetch", "description": "Fetch URLs"},
    {"name": "db_query", "description": "Query PostgreSQL database"},
    {"name": "deploy", "description": "Deploy to staging environment"}
  ],
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/myapp"]
    }
  }
}
